{
  "name": "ghost-museum",
  "private": true,
  "version": "0.1.0",
  "description": "A hall of interfaces that outlived their obituaries.",
  "type": "module",
  "scripts": {
    "probe": "node scripts/probe.mjs",
    "validate": "node scripts/validate.mjs",
    "demo": "node scripts/demo-server.mjs",
    "hunt": "node scripts/hunt.mjs",
    "recheck": "node scripts/recheck.mjs",
    "curate": "node scripts/curate.mjs",
    "curate:desk": "node scripts/curate.mjs --desk",
    "hang": "node scripts/hang.mjs",
    "hang:auto": "node scripts/hang-auto.mjs",
    "hang:drain": "node scripts/hang-drain-loop.mjs",
    "search:seed": "node scripts/search-seed.mjs",
    "discover": "node scripts/discover.mjs",
    "autoseed": "node scripts/autoseed.mjs",
    "authority": "node scripts/authority-loop.mjs",
    "authority:once": "node scripts/authority-loop.mjs",
    "authority:loop": "node scripts/authority-loop.mjs --loop",
    "seed-watchlist": "node scripts/seed-watchlist.mjs",
    "seed-watchlist:broad": "node scripts/seed-watchlist.mjs --broad",
    "seed-watchlist:deep": "node scripts/seed-watchlist.mjs --deep",
    "seed-watchlist:vast": "node scripts/seed-watchlist.mjs --vast",
    "sync-exhibits": "node -e \"import('node:fs').then(fs=>fs.copyFileSync('exhibits/exhibits.json','site/exhibits.json'))\"",
    "check": "npm run validate"
  }
}
